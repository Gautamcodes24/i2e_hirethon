{
  "name": "Tech Manual QA",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "user": "ubuntu",
  "install": "./scripts/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd \"$CURSOR_WORKSPACE_ROOT\" && .venv/bin/uvicorn backend.server.app:app --host 0.0.0.0 --port 8000",
      "description": "FastAPI backend serving the RAG API and pre-built React UI on port 8000"
    }
  ],
  "ports": [
    {
      "name": "app",
      "port": 8000
    }
  ]
}
